@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager NavigationManager

<div class="page">
    @if (!_isLoginPage)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        <div class="top-row px-4" />

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _isLoginPage;

    protected override void OnInitialized()
    {
        UpdateLoginPageState();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateLoginPageState();
        StateHasChanged();
    }

    private void UpdateLoginPageState()
    {
        string path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .TrimEnd('/');
        _isLoginPage = string.Equals(path, "Account/Login", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
